generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  role      Role     @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  CUSTOMER
  ADMIN
}

model Gown {
  id         String      @id @default(cuid())
  slug       String?     @unique
  name       String
  description String
  price      Float
  sizes      String[]
  images     String[]
  category   String
  subcategory String?
  isCustomizable Boolean   @default(false)
  isSoldOut  Boolean    @default(false)
  rating     Float      @default(5.0)
  reviewsCount Int      @default(0)
  orderItems OrderItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([category])
  @@index([subcategory])
}

model Order {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  status      OrderStatus  @default(PENDING)
  totalAmount Float
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  gownId    String
  gown      Gown    @relation(fields: [gownId], references: [id])
  size      String
  quantity  Int
  price     Float
}

model ClientOnboarding {
  id                 String   @id @default(cuid())

  // ── 01 The Bride ──────────────────────────────────────────────────
  fullName           String
  preferredName      String?
  phoneNumber        String              // WhatsApp / Phone
  emailAddress       String
  instagramHandle    String?
  hearAboutUs        String?

  // ── 02 Your Wedding ───────────────────────────────────────────────
  eventDate          String?             // Wedding date
  ceremonyLocation   String              // Wedding location / venue
  weddingCityCountry String?
  weddingTypes       String[]
  weddingStyleTheme  String?
  guestCount         String?
  weddingPlanner     String?

  // ── 03 Your Bridal Look ───────────────────────────────────────────
  bridalServices     String[]
  numberOfLooks      String?
  dreamGownDescription String?

  // ── 04 Your Bridal Aesthetic ──────────────────────────────────────
  visionWords        String[]
  silhouettePrefs    String[]
  necklinePrefs      String[]
  sleevePrefs        String[]
  trainPrefs         String[]

  // ── 05 Fabric, Colour & Embellishment ─────────────────────────────
  bridalColour       String[]
  bridalColourOther  String?
  fabricPrefs        String[]
  embellishmentPrefs String[]
  hasFabric          String?
  fabricImageUrl     String?

  // ── 06 Your Inspiration ───────────────────────────────────────────
  hasInspiration     String?
  inspirationImageUrls String[]
  lovedElements      String?
  avoidedElements    String?
  moodBoardLink      String?

  // ── 07 Bridal Party ───────────────────────────────────────────────
  bridalPartyOutfits String?
  bridalPartyMembers String[]
  bridalPartyCount   String?
  bridalPartyColours String?
  bridalPartyCoordination String?

  // ── 08 Fit & Personal Preferences ─────────────────────────────────
  preferredFit       String?
  attentionAreas     String?
  avoidFeatures      String?
  comfortRequirements String?

  // ── 09 Your Investment ────────────────────────────────────────────
  investmentRange    String?
  looksCovered       String?

  // ── 10 Timeline ───────────────────────────────────────────────────
  desiredCompletionDate String?
  dateFlexibility    String?
  isRushOrder        String?
  rushTimeline       String?
  bookedAnotherDesigner String?

  // ── 11 Consultation preferences ───────────────────────────────────
  // Indicative only. The binding appointment is made through the
  // booking link the bride receives once the designer accepts her.
  preferredConsultFormat String?
  preferredConsultDate   String?
  preferredConsultTime   String?
  consultationGoals      String?
  consultantNotes        String?

  // ── 12 Bridal Client Acknowledgement ──────────────────────────────
  acknowledgements   String[]
  declarationName    String?
  agreedToTerms      Boolean  @default(false)

  // ── Legacy (pre-2026-08 form) — retained so old rows still read ───
  receptionLocation  String?
  typeOfGown         String[]
  desiredSilhouette  String?
  preferredNeckline  String?
  sleevePreference   String?
  trainLength        String[]
  threeWords         String?
  feelWearing        String?
  loveBodyParts      String?
  softenConceal      String?
  budgetRange        String[]
  readyForDeposit    String?
  paymentStructure   String?
  brandConfirmations String[]
  declarationDate    String?

  // ── Designer review ───────────────────────────────────────────────
  status                OnboardingStatus @default(PENDING_REVIEW)
  reviewNote            String?
  reviewedBy            String?
  reviewedAt            DateTime?

  // ── Consultation booking link ─────────────────────────────────────
  bookingToken          String?   @unique
  bookingTokenExpiresAt DateTime?

  consultation       Consultation?
  measurementSheet   MeasurementSheet?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([emailAddress])
  @@index([status])
}

enum OnboardingStatus {
  PENDING_REVIEW
  ACCEPTED
  DECLINED
  CONSULTATION_BOOKED
  CONSULTED
}

enum ConsultationFormat {
  IN_PERSON
  VIRTUAL
}

enum ConsultationStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Consultation {
  id              String             @id @default(cuid())
  onboardingId    String             @unique
  onboarding      ClientOnboarding   @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  scheduledAt     DateTime
  durationMinutes Int                @default(60)
  format          ConsultationFormat @default(IN_PERSON)
  location        String?
  meetingLink     String?
  status          ConsultationStatus @default(BOOKED)

  clientNote      String?
  studioNote      String?

  measurementSheet MeasurementSheet?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

model MeasurementSheet {
  id               String            @id @default(cuid())
  onboardingId     String            @unique
  onboarding       ClientOnboarding  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  consultationId   String?           @unique
  consultation     Consultation?     @relation(fields: [consultationId], references: [id])

  takenBy          String?

  // Body info
  height           String?
  weight           String?
  braSize          String?
  dressSize        String?
  shoeSize         String?

  // Upper body
  bust             String?
  underbust        String?
  highBust         String?
  shoulderWidth    String?
  neck             String?
  shoulderToWaist  String?

  // Lower body
  waist            String?
  hip              String?
  waistToFloor     String?
  shoulderToFloor  String?

  // Arms
  armhole          String?
  bicep            String?
  sleeveLength     String?

  // Fit & style
  preferredFit     String?
  corsetPref       String?
  heelHeight       String?
  trainLength      String?

  // Accuracy
  posture          String?
  notes            String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  date          DateTime      @default(now())
  dueDate       String?       // "On Receipt", "Net 30", etc. or a date
  clientName    String
  clientEmail   String?
  clientPhone   String?
  clientAddress String?
  totalAmount   Float
  balanceDue    Float
  status        InvoiceStatus @default(PENDING)
  isActive      Boolean       @default(true)
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([invoiceNumber])
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  rate        Float
  quantity    Int
  amount      Float
}
