{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "akuann-admin",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "akuann-admin"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Workers cannot complete the Postgres STARTTLS upgrade against Supabase's
  // pooler: the handshake succeeds and the first write then fails with
  // "Network connection lost". Hyperdrive terminates that connection off-isolate
  // and hands the Worker a local, plaintext connection string instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "be5011a183b34fea813574e33eb755a3",
      // Unused placeholder. `opennextjs-cloudflare deploy` boots miniflare to
      // read env vars, and miniflare refuses to start unless every Hyperdrive
      // binding has a local string, even when the command is a deploy. The real
      // local value goes in CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
      // (see .env.example), which takes precedence over this.
      //
      // Query caching is turned off on this config (`wrangler hyperdrive update
      // <id> --caching-disabled`). It is on by default and served reads up to a
      // minute stale, which showed up as a deleted invoice still appearing in
      // the list. Live updates are pointless if the refresh they trigger can
      // return stale rows, and this is a low-traffic admin dashboard where
      // freshness is worth more than cache hits.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  "observability": {
    "enabled": true
  }
}
