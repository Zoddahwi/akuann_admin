# Required for the internal dashboard login. Do not commit real values.
ADMIN_EMAIL=studio@example.com
ADMIN_PASSWORD=qwerty123
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-value-at-least-32-characters-long

# Postgres. Used directly by `next dev` and by Prisma migrations.
# Supabase's pooler needs uselibpqcompat=true alongside sslmode=require: pg 8.23
# reads a bare sslmode=require as verify-full, and the pooler presents a private
# self-signed chain that is in no public trust store.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Deployed Workers reach Postgres through the Hyperdrive binding in
# wrangler.jsonc, because Workers cannot complete the Postgres STARTTLS upgrade
# against the Supabase pooler. `next dev` has no real Hyperdrive, so the binding
# falls back to this value. Point it at the pooler in session mode (5432), which
# is the same origin the production Hyperdrive config uses.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://user:password@host:5432/postgres?uselibpqcompat=true&sslmode=require"
